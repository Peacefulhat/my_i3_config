set nocompatible
filetype on
syntax on
filetype plugin on
set cursorline
highlight CursorLine cterm=NONE ctermbg=235
highlight CursorLineNr cterm=NONE ctermbg=235
set modelines=0
set number
set encoding=utf-8
set wrap
set tabstop=2
set shiftwidth=2
set autoindent
set expandtab
set noshiftround
set hlsearch
set incsearch
set showmatch
set smartcase
set hidden
set background=dark
